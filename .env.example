# Postgres — single database for both engine tables (agent_messages,
# executions) and app/business tables (services, chats, orders, faqs,
# payment_methods). They share the DB but keep separate migration histories.
DATABASE_URL=postgres://user:pass@localhost:5432/neuron

# Telegram bot token.
TELEGRAM_BOT_TOKEN=

# OpenRouter credentials (the conversational agent).
# Any OpenRouter model id (https://openrouter.ai/models), e.g. google/gemini-2.5-flash.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Native Gemini credentials for reading images (Files API).
# API key from https://aistudio.google.com/apikey ; a vision model id, e.g. gemini-2.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional — HTTP listen port. Defaults to 3000.
# PORT=3000
