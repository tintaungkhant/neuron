# Engine — Postgres for chat memory (agent_messages table).
DATABASE_URL=postgres://user:pass@localhost:5432/engine

# Demo project — Telegram bot token.
DEMO_TELEGRAM_BOT_TOKEN=

# Demo project — OpenRouter credentials.
# Any OpenRouter model id (https://openrouter.ai/models), e.g. openai/gpt-4o-mini.
DEMO_OPENROUTER_API_KEY=
DEMO_OPENROUTER_MODEL=openai/gpt-4o-mini

# Demo project — Postgres for project tables (services, chats, orders, faqs,
# payment_methods). Same host as DATABASE_URL is fine, just a different db.
DEMO_DATABASE_URL=postgres://user:pass@localhost:5432/demo

# Optional — HTTP listen port. Defaults to 3000.
# PORT=3000
